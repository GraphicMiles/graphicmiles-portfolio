# Add an Upstash Redis integration to the Vercel project. The integration
# normally creates these two values automatically.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=replace-with-your-rest-token

# Generate with: openssl rand -hex 32
VISITOR_HASH_SALT=replace-with-a-long-random-secret
