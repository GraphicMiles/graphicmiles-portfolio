{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node static-build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/screenrant",
      "destination": "/breakdown",
      "permanent": true
    },
    {
      "source": "/screenrant/:path*",
      "destination": "/breakdown/:path*",
      "permanent": true
    }
  ]
}
